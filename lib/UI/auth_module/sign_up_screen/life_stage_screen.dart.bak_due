import 'package:flutter/material.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';
import 'package:get/get.dart';

import '../../../data/controllers/consultation_controller/consultation_controller.dart';

import '../../../widgets/onboarding_scaffold.dart';
import '../../../widgets/toasts.dart';

/// Signup step: "Which of these fits you right now?"
///
/// One tap. The value is saved to the pre-consultation profile
/// (`pregnancyMenstrualStatus`) so the trial and paid forms, the AI
/// diet plan and the dietitian all read the same answer and she is
/// never asked again.
///
/// Values match the ones the trial / paid forms already use, plus
/// `trying_to_conceive`.
class LifeStageOption {
  final String value;
  final String emoji;
  final String title;
  final String subtitle;
  const LifeStageOption(this.value, this.emoji, this.title, this.subtitle);
}

const List<LifeStageOption> kLifeStageOptions = [
  LifeStageOption('regular_cycle', '🗓️', 'My periods come on time',
      'Around the same time each month'),
  LifeStageOption('irregular_cycle', '🔄', 'My periods are irregular',
      'Early, late or sometimes skipped'),
  LifeStageOption('trying_to_conceive', '🌱', 'Trying for a baby',
      'Planning to get pregnant'),
  LifeStageOption('pregnant', '🤰', "I'm pregnant",
      "We'll keep everything gentle and safe"),
  LifeStageOption('postpartum', '🤱', 'I recently had a baby',
      'Within the last 12 months'),
  LifeStageOption('menopause', '🍂', 'My periods have stopped',
      'Menopause or close to it'),
  LifeStageOption('prefer_not_to_say', '🤍', "I'd rather not say",
      'You can add this later'),
];

/// True when the cycle questions (last period date etc.) make sense.
bool lifeStageHasPeriods(String? value) =>
    value == 'regular_cycle' ||
    value == 'irregular_cycle' ||
    value == 'trying_to_conceive';

class LifeStageScreen extends StatefulWidget {
  final int currentStep;
  final int totalSteps;
  final String? initialValue;
  final Future<void> Function(String value) onNext;

  const LifeStageScreen({
    Key? key,
    this.currentStep = 5,
    this.totalSteps = 8,
    this.initialValue,
    required this.onNext,
  }) : super(key: key);

  @override
  State<LifeStageScreen> createState() => _LifeStageScreenState();
}

class _LifeStageScreenState extends State<LifeStageScreen> {
  String? _selected;

  bool _busy = false;

  @override
  void initState() {
    super.initState();
    _selected = widget.initialValue;
    // Coming back to signup (changed her answer, or waiting time over):
    // show what she picked last time.
    if (_selected == null) {
      Get.find<ConsultationController>().getLifeStage().then((ls) {
        final s = ls?['status'];
        if (!mounted || _selected != null || s is! String) return;
        if (kLifeStageOptions.any((o) => o.value == s)) {
          setState(() => _selected = s);
        }
      });
    }
  }

  Future<void> _next() async {
    if (_busy) return;
    if (_selected == null) {
      CustomToast.failToast(msg: 'Please pick the one that fits you');
      return;
    }
    setState(() => _busy = true);
    await widget.onNext(_selected!);
    if (mounted) setState(() => _busy = false);
  }

  @override
  Widget build(BuildContext context) {
    return OnboardingScaffold(
      currentStep: widget.currentStep,
      totalSteps: widget.totalSteps,
      badgeText: 'Your body',
      questionLine1: 'Which of these',
      questionLine2: 'fits you right now?',
      subtitle: 'This helps us keep your meals and workouts safe for you.',
      buttonText: _busy ? 'Saving…' : 'Next →',
      onNext: _next,
      body: Column(
        children: [
          for (final o in kLifeStageOptions)
            Padding(
              padding: EdgeInsets.only(bottom: 12.h),
              child: _OptionCard(
                option: o,
                selected: _selected == o.value,
                onTap: () => setState(() => _selected = o.value),
              ),
            ),
          Padding(
            padding: EdgeInsets.only(top: 4.h),
            child: Text(
              'You can always change this later',
              style: TextStyle(
                fontFamily: 'Poppins',
                fontSize: 12.sp,
                color: OnboardingScaffold.textMuted,
              ),
            ),
          ),
        ],
      ),
    );
  }
}

/// Same card as the goal step: 18 radius, emoji 26, title 16 w600,
/// subtitle 12 w300, 24px radio on the right.
class _OptionCard extends StatelessWidget {
  final LifeStageOption option;
  final bool selected;
  final VoidCallback onTap;

  const _OptionCard({
    required this.option,
    required this.selected,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      behavior: HitTestBehavior.opaque,
      onTap: onTap,
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 150),
        padding: EdgeInsets.symmetric(horizontal: 20.w, vertical: 18.h),
        decoration: BoxDecoration(
          color: selected
              ? OnboardingScaffold.optionSelectedBg
              : OnboardingScaffold.optionBg,
          borderRadius: BorderRadius.circular(18.r),
          border: Border.all(
            color: selected ? OnboardingScaffold.green : Colors.transparent,
            width: 2,
          ),
        ),
        child: Row(
          children: [
            Text(option.emoji, style: TextStyle(fontSize: 26.sp)),
            SizedBox(width: 14.w),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    option.title,
                    style: TextStyle(
                      fontFamily: 'Poppins',
                      fontSize: 16.sp,
                      fontWeight: FontWeight.w600,
                      color: OnboardingScaffold.textDark,
                    ),
                  ),
                  SizedBox(height: 2.h),
                  Text(
                    option.subtitle,
                    style: TextStyle(
                      fontFamily: 'Poppins',
                      fontSize: 12.sp,
                      fontWeight: FontWeight.w300,
                      color: OnboardingScaffold.textMuted,
                    ),
                  ),
                ],
              ),
            ),
            Container(
              width: 24.w,
              height: 24.w,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: selected ? OnboardingScaffold.green : Colors.transparent,
                border: Border.all(
                  color: selected
                      ? OnboardingScaffold.green
                      : OnboardingScaffold.radioBorder,
                  width: 2,
                ),
              ),
              child: selected
                  ? Icon(Icons.check_rounded, size: 15.sp, color: Colors.white)
                  : null,
            ),
          ],
        ),
      ),
    );
  }
}
