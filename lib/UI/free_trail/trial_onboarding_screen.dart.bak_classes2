                Text(
                  title.toUpperCase(),
                  style: const TextStyle(
                    fontFamily: 'Poppins',
                    fontSize: 11,
                    fontWeight: FontWeight.w700,
                    color: _kInkSoft,
                    letterSpacing: 0.8,
                  ),
                ),
                const SizedBox(height: 6),
                ...lines.where((l) => l.trim().isNotEmpty).map((l) => Padding(
                      padding: const EdgeInsets.only(bottom: 3),
